modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"
build = "pnpm run build"
run = "pnpm start"

[[ports]]
localPort = 8080
externalPort = 80

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
