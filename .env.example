# Local development only. On Replit these are injected automatically and
# this file is never read there (see artifacts/*/src/**/load-local-env.ts
# and artifacts/*/vite.config.ts).
#
# To run locally:
#   1. cp .env.example .env
#   2. Fill in the values below
#   3. pnpm install
#   4. pnpm --filter @workspace/api-server run dev      (terminal 1, port 8080)
#   5. pnpm --filter @workspace/rhetoric-xray run dev    (terminal 2, port 21905)
#   6. pnpm --filter @workspace/admin-console run dev    (terminal 3, port 21906)
#   7. Open http://localhost:21905 (site) / http://localhost:21906 (後台)

# Postgres connection string. Any local/hosted Postgres works, e.g.
# postgresql://user:password@localhost:5432/rhetoric_xray
# After setting this, run: pnpm --filter @workspace/db run push
DATABASE_URL=

# OpenAI API key used for OCR (gpt-4o-mini) and rhetoric analysis (gpt-4o).
OPENAI_API_KEY=

# --- Admin console (artifacts/admin-console) ---------------------------
# Required for the /api/admin/* routes and the admin login page to work at
# all — without these, admin endpoints return 503. On Replit these must be
# set as Deployment Secrets (they are NOT injected automatically like
# DATABASE_URL is).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signs the admin session cookie. Set this to a long random string (e.g.
# `openssl rand -hex 32`) so admin logins survive a server restart/redeploy
# — if left unset, a random secret is generated at boot and every admin
# session is invalidated on the next restart.
ADMIN_SESSION_SECRET=

# Optional. Only used by the frontend dev servers' local /api proxy
# (artifacts/rhetoric-xray/vite.config.ts, artifacts/admin-console/vite.config.ts).
# Defaults to http://localhost:8080 — override only if you run the
# api-server on a different port.
# API_PROXY_TARGET=
